{
  "name": "blockchain-order-tracking",
  "version": "1.0.0",
  "description": "Blockchain Smart Contract for Order Tracking System",
  "main": "scripts/deploy.js",
  "scripts": {
    "test": "hardhat test",
    "test:gas": "REPORT_GAS=true hardhat test",
    "compile": "hardhat compile",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
    "deploy:sepolia": "hardhat run scripts/deploy.js --network sepolia",
    "deploy:mumbai": "hardhat run scripts/deploy.js --network mumbai",
    "deploy:polygon": "hardhat run scripts/deploy.js --network polygon",
    "node": "hardhat node",
    "verify:sepolia": "hardhat verify --network sepolia",
    "verify:mumbai": "hardhat verify --network mumbai",
    "flatten": "hardhat flatten contracts/OrderTracking.sol > artifacts/OrderTracking.flattened.sol",
    "clean": "hardhat clean",
    "help": "hardhat help"
  },
  "keywords": [
    "blockchain",
    "ethereum",
    "smart-contract",
    "order-tracking",
    "solidity"
  ],
  "author": "Your Team",
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^3.0.0",
    "@nomiclabs/hardhat-waffle": "^2.0.6",
    "chai": "^4.3.7",
    "ethereum-waffle": "^4.0.10",
    "ethers": "^6.0.0",
    "hardhat": "^2.17.0",
    "hardhat-gas-reporter": "^1.0.9",
    "solidity-coverage": "^0.8.4"
  },
  "dependencies": {
    "dotenv": "^16.3.1"
  }
}
