# Environment Variables Configuration
# Copy this file to .env and fill in your actual values

# ==================== SERVER ====================
NODE_ENV=development
PORT=3000

# ==================== BLOCKCHAIN ====================
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
CONTRACT_ADDRESS=0x5663b4AF89cFBFf92A29F8cb53516B705eF055C8
PRIVATE_KEY=your_private_key_without_0x_prefix

# ==================== DATABASE ====================
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/order-tracking?retryWrites=true&w=majority

# ==================== EMAIL ====================
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your_app_password_not_regular_password

# ==================== LOGGING ====================
LOG_LEVEL=info

# ==================== CORS ====================
CORS_ORIGIN=http://localhost:3001

# ==================== ENVIRONMENT NOTES ====================
# 
# SEPOLIA_RPC_URL: 
#   - Get from Infura (https://infura.io) or Alchemy (https://alchemy.com)
#   - Format: https://sepolia.infura.io/v3/YOUR_KEY
#
# CONTRACT_ADDRESS:
#   - Smart contract address deployed on Sepolia testnet
#   - Default: 0x5663b4AF89cFBFf92A29F8cb53516B705eF055C8
#
# PRIVATE_KEY:
#   - Admin wallet private key (without 0x prefix)
#   - NEVER commit to git or share publicly
#   - Should have some ETH for gas fees
#
# MONGODB_URI:
#   - MongoDB Atlas connection string
#   - Format: mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority
#   - Create account at https://www.mongodb.com/cloud/atlas
#
# EMAIL_USER & EMAIL_PASSWORD:
#   - Gmail address for sending notifications
#   - EMAIL_PASSWORD should be App Password, NOT regular Gmail password
#   - Generate App Password at https://myaccount.google.com/apppasswords
#   - Requires 2FA enabled on Gmail account
#
# CORS_ORIGIN:
#   - Frontend URL for CORS policy
#   - Local development: http://localhost:3001
#   - Production: your-frontend-domain.com
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY
GOERLI_RPC_URL=https://eth-goerli.g.alchemy.com/v2/YOUR_API_KEY
MUMBAI_RPC_URL=https://polygon-mumbai.g.alchemy.com/v2/YOUR_API_KEY
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_API_KEY
MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY

# Localhost khi chạy local node
RPC_URL=http://localhost:8545

# Contract address sau khi deploy
CONTRACT_ADDRESS=0x...

# API keys cho verification trên explorer
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY
POLYGONSCAN_API_KEY=YOUR_POLYGONSCAN_API_KEY

# Block để bắt đầu sync historical events
START_BLOCK=0

# ==================== DATABASE ====================
# MongoDB connection
MONGODB_URI=mongodb://localhost:27017/order-tracking

# MongoDB Atlas (nếu dùng cloud)
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/order-tracking

# ==================== IPFS ====================
# IPFS node connection
IPFS_API_URL=http://localhost:5001
IPFS_GATEWAY_URL=http://localhost:8080/ipfs

# Hoặc dùng Pinata (IPFS service)
PINATA_API_KEY=YOUR_PINATA_API_KEY
PINATA_API_SECRET=YOUR_PINATA_API_SECRET

# ==================== BACKEND API ====================
# Port cho backend server
PORT=3000

# Environment
NODE_ENV=development
# NODE_ENV=production

# JWT Secret (nếu dùng authentication)
JWT_SECRET=YOUR_JWT_SECRET_KEY

# ==================== LOGGING ====================
LOG_LEVEL=info
# LOG_LEVEL=debug
